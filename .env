# Token of the MAIN management bot (get one from @BotFather).
BOT_TOKEN=123456789:AAExampleTokenGoesHereReplaceMe

# Comma separated Telegram user IDs allowed to use the management panel.
ADMIN_IDS=111111111,222222222

# Path to the SQLite database file.
DB_PATH=data.db

# Directory where log files (manager.log, errors.log) are written.
LOG_DIR=logs

# Default reaction emoji assigned to newly added bots.
DEFAULT_EMOJI=👍
